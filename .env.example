# Server
PORT=3001
NODE_ENV=development

# Payments: offline Invoice / mail check only (super_admin marks paid)
# (Stripe / stub card checkout removed)

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=rose_associates_scorecard

# JWT Authentication & Session
JWT_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Storage Provider (minio or s3)
STORAGE_DRIVER=minio
STORAGE_ENV_PREFIX=dev

# MinIO / S3 Configuration
# For local MinIO:
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=rose-media

# For Production AWS S3 (uncomment when deploying to AWS):
# STORAGE_DRIVER=s3
# STORAGE_ENV_PREFIX=prod
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# S3_FORCE_PATH_STYLE=false

CENSUS_API_KEY=
BLS_API_KEY=
EPA_API_EMAIL=
EPA_API_KEY=
ARCGIS_API_TOKEN=

# =============================================================================
# SMTP Email Configuration (Nodemailer)
# =============================================================================
# For Gmail Testing:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_char_google_app_password
#
# For Rose Associates Production / Custom Mail Server:
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@roseassociates.com
SMTP_PASS=
MAIL_FROM="Rose Associates <info@roseassociates.com>"
MAIL_FROM_PORTAL="Rose Associates <info@roseassociates.com>"
ADMIN_INQUIRY_EMAIL=info@roseassociates.com
APP_LOGO_URL=

# Confidential pricing brochure (County/City leads only).
# Keep the PDF at this S3 key; the app only mints a fresh 7-day signed URL per inquiry.
# BROCHURE_S3_KEY=Rose/private/subscription-pricing-brochure.pdf
# BROCHURE_SIGNED_URL_TTL_SECONDS=604800

# Frontend base URL (used in payment confirmation email Log in CTA)
# Local FE (vite --port 3000). Production: https://roseassociates.shaligraminfotech.com
FRONTEND_URL=http://localhost:3000